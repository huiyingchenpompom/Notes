10.关于骨骼以及蒙皮的渲染是如何实现的？
-关于骨骼的渲染
  主要是骨骼pose计算，三维窗口的骨架的渲染
  首先代码结构的设计上，骨骼数据的计算和显示需要分开来，也就是数显分离的思维。
  然后是骨骼预加载，先加载骨骼文件对骨骼数据进行一个初始化。
      骨骼文件的加载：骨骼文件有骨骼名称，关节方向jo，translate平移，旋转，旋转轴顺序，锁定信息等数据，以及骨骼的父子关系。
                    读取骨骼文件第一步就是根据骨骼文件中的父子关系建立骨骼树，然后递归遍历每一个骨骼关节，根据骨骼的关节方向和translate及旋转值计算每一根骨骼的全局矩阵和局部坐标矩阵
                    骨架初始化完成
      三维渲染窗口：接收pose更新的消息，拿到最新的动作数据，根据骨骼树对骨架进行更新。三维骨架是根据一根一根地三角锥组成，只需要知道两个点就可以绘制
                  根据每根骨骼的全局矩阵计算当前骨骼的点，在拿到父节点的全局矩阵计算的点，根据两个点就可以绘制出当前的骨骼，循环更新所有的骨骼
                  每一根绘制的骨骼都是一个渲染模型单位，写对应的顶点着色器，和绘制基类实现
-关于蒙皮的渲染
  主要是蒙皮数据的准备，蒙皮根据骨骼的变换，渲染
  蒙皮的数据准备，包括顶点，法线，面(face,顶点索引数组)以及 骨骼id、权重的数据
  蒙皮跟着骨骼的形变,是根据设置一个变换矩阵，根据影响该蒙皮的骨骼，计算出全局的变换矩阵 =骨骼全局变换*原始全局变化.inverse()
  蒙皮的顶点着色器，需要注意的是，蒙皮矩阵的存储可以用紧凑的方式存储骨骼变换矩阵，以及根据骨骼数动态变化蒙皮矩阵的大小

蒙皮着色器示例：
#version 330 core

layout(location = 0) in vec3 vPos;
layout(location = 1) in vec3 vNormal;
layout(location = 2) in vec2 vUV;
layout(location = 3) in vec4 vBones;
layout(location = 4) in vec4 vWeights;

out vec3 FragPos;
out vec3 Normal;

uniform mat4 projection;
uniform mat4 view;
uniform mat4 model;

layout(std140) uniform Matrices { 
    vec4 node_w2w[ARRAY_SIZE_PLACEHOLDER]; 
};

void main(void)
{
    vec4 blendPos = vec4(0,0,0,0);
    vec3 blendNorm = vec3(0,0,0);

    if(vBones[0]<0)
    {
        blendPos = vec4(vPos, 1.0);
        blendNorm = vNormal;
    }

    for (int i = 0; i < 4; i++)
    {
        int idx = int(vBones[i]) * 3;
        if (idx < 0)
        {
             break;
        }
        // first, second and third column
        mat4 w2w;
        w2w[0] = node_w2w[idx];
        w2w[1] = node_w2w[idx+1];
        w2w[2] = node_w2w[idx+2];
        w2w[3] = vec4(0.0,0.0,0.0,1.0);

        float weight = vWeights[i];
        blendPos += (vec4(vPos, 1.0) * w2w).xyzw * weight;

        mat3 w2w_r = mat3(w2w[0].xyz, w2w[1].xyz, w2w[2].xyz);
        blendNorm += (vNormal * w2w_r) * weight;
    }

    gl_Position = projection * view * model * blendPos;

    FragPos = vec3(model * vec4(blendPos));

    Normal = mat3(transpose(inverse(model))) * blendNorm;
}



